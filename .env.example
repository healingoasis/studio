# Healing Oasis Studio secrets
# Copy this file to .env.local and fill in real values. Dan (Kite Agency) provides them.
# .env.local is never committed. Never paste these values into any other file or chat.

# Shopify (the store: healing-oasis-us.myshopify.com)
SHOPIFY_STORE=healing-oasis-us.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET_KEY=

# Firebase / Google Cloud (project: healing-io, private enrollment data)
FIREBASE_PROJECT_ID=healing-io
# Path to a service account key file, kept in the gitignored .secrets/ folder
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/healing-io-service-account.json
