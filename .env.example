# Healing Oasis Studio secrets
# Copy this file to .env.local and fill in real values. Dan (Kite Agency) provides them.
# .env.local is never committed. Never paste these values into any other file or chat.

# Shopify (the store: healing-oasis-us.myshopify.com)
SHOPIFY_STORE=healing-oasis-us.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET_KEY=

# Firebase / Google Cloud (project: healing-oasis, private enrollment data)
# Confirmed against Google on 2026-09-01: healing-oasis is the only project on the
# account. There is no "healing-io" — that name was wrong here from the start.
FIREBASE_PROJECT_ID=healing-oasis
FIREBASE_STORAGE_BUCKET=healing-oasis.firebasestorage.app
# No service account key file. Daniel signs in as himself with the Google Cloud CLI:
#   gcloud auth login
#   gcloud auth application-default login
# That writes credentials to ~/.config/gcloud/, outside this repo, and the Firebase
# Admin SDK picks them up automatically. Nothing to paste, no key to leak.
