# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.next-review/
.turbo/
out/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Runtime-written data (NEVER tracked) — see SKILL.md "Repository layout"
.data/
tmp/

# Class photographs copied in from Daniel's Mac. This repo is PUBLIC, and these show
# identifiable students, staff and clients — they stay on the machine.
apps/*/public/photos/

# Note: data/ is intentionally NOT ignored. It holds tracked source-of-truth
# seeds and fixtures only. Runtime persistence belongs in .data/ or tmp/.

# Local tooling
.DS_Store
*.log
coverage/
.vscode/
.idea/

# Local key files (service accounts etc.)
.secrets/

# Rendered output — regenerated by build.mjs plus headless Chrome, and the
# finished files live in Google Drive. Committing them bloated .git to 434M.
apps/*/png/
apps/*/jpg/
apps/*/build/
apps/*/deliver/
apps/*/carousel/png/
apps/*/carousel/thumb/
apps/*/carousel/deliver/
apps/*/review.html
apps/*/carousel/review.html
tools/ffmpeg

# Generated review material: hundreds of MB of JPEGs, rebuildable
# from the footage at any time with extract.py + sheets.py.
tools/footage-index/index/
